    "settings.widget.style.bleed" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Day Silhouette"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数影"
          }
        }
      }
    },
    "settings.widget.style.bleed.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The sun leans west; shadows count the hours for the silent grass. When green crosses the paper’s edge, the day gains depth."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日头一路西斜，影子替沉默的草数着时辰。等绿意越过纸边，这一天便有了深浅。"
          }
        }
      }
    },
    "settings.widget.style.field" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quiet Field"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "静场"
          }
        }
      }
    },
    "settings.widget.style.field.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sound falls away; its echo widens into silence. The empty field holds its center for today."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一声落下，余响一圈圈走远。场子空着，只替今天守住最中心的位置。"
          }
        }
      }
    },
    "settings.widget.style.letter" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Letter"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手札"
          }
        }
      }
    },
    "settings.widget.style.letter.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sheet lies open, a few words scattered across it. Somehow, the afternoon stretches on."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "信纸摊开，字疏疏落落，下午却显得很长。"
          }
        }
      }
    },
    "settings.widget.style.orbit" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Star Ring"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "星环"
          }
        }
      }
    },
    "settings.widget.style.orbit.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toward dawn, the stars recede one by one. One remains on the ring, waiting for today to fall into place."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "天快亮时，群星一颗颗退远。只有这一颗留在环上，等今天归位。"
          }
        }
      }
    },
    "settings.widget.style.path" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Path"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来路"
          }
        }
      }
    },
    "settings.widget.style.path.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fine path winds in from the hills, carrying days of wind and rain. By the time it reaches today, only your step is missing."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一线从远山蜿蜒而来，沿途收下几日风雨。到了今天，它只差你这一步。"
          }
        }
      }
    },
    "settings.widget.style.per_instance" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set for each widget"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个小组件独立设置"
          }
        }
      }
    },
    "settings.widget.style.place" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Awaiting Place"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "待落之处"
          }
        }
      }
    },
    "settings.widget.style.place.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Night still clings to the grass as morning clears the hill. A small clearing at the center waits for today’s check-in."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "草尖还留着昨夜，晨光已越过远处的坡。中间那一小处空白，正等今天签到。"
          }
        }
      }
    },
    "settings.widget.style.stack" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stacked Imprints"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "叠印"
          }
        }
      }
    },
    "settings.widget.style.stack.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The pages lie quietly stacked, each edge holding a trace of light. One imprint, and the day takes on weight."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "纸页叠得很静，边角各自含着一点光。一枚印落下，今天便有了重量。"
          }
        }
      }
    },
    "settings.widget.style.tide" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tide Mark"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "潮痕"
          }
        }
      }
    },
    "settings.widget.style.tide.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once the tide has come and gone, light on the sand can tell morning from evening. The day finds its rhythm there."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "潮水走过一遭，沙上的光便有了早晚，一天也跟着有了节奏。"
          }
        }
      }
    },
    "startup.failure.persistence_message" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulse could not read your data. Try again. If the problem continues, contact support before deleting the app."
          }
        },
        "zh-Hans" : {
